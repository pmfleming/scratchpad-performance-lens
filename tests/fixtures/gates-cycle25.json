  "benchmark_targets.json": {
    "tab_reorder_latency": {
      "description": "Reorder a tab from near the start to the end and back as tab count grows.",
      "workload_family": "tab-management",
      "parameter_unit": "tabs",
      "kind": "workflow",
      "threshold_ms": 16.0,
      "targets": [
        "src/app/domain/tab_manager.rs",
        "src/app/domain/tab_manager/index.rs"
      ],
      "limiting_resource_hint": "cpu",
      "measurement_contract": {
        "text_backing": "owned",
        "production_path": true,
        "code_path": "src/app/domain/tab_manager.rs;src/app/domain/tab_manager/index.rs"
      }
    },
    "paste_insert_phase": {
      "description": "Diagnostic insertion phase for a 128 MiB mixed UTF-8 paste, excluding fixture setup and metadata refresh.",
      "workload_family": "edit-paste",
      "parameter_unit": "bytes",
      "kind": "diagnostic",
      "targets": [
        "src/app/domain/buffer/piece_tree"
      ],
      "limiting_resource_hint": "cpu",
      "measurement_contract": {
        "text_backing": "owned",
        "production_path": false,
        "code_path": "src/app/domain/buffer/piece_tree"
      }
    },
    "paste_metadata_phase": {
      "description": "Diagnostic synchronous metadata-refresh phase after a 128 MiB mixed UTF-8 paste.",
      "workload_family": "edit-paste",
      "parameter_unit": "bytes",
      "kind": "diagnostic",
      "targets": [
